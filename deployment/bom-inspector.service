[Unit]
Description=Industrial Conveyor Belt BOM Vision Inspector
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/bom-inspector
ExecStart=/opt/bom-inspector/.venv/bin/python -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
